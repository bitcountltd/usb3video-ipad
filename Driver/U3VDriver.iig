//
//  U3VDriver.iig
//  USB3 Vision camera driver: owns the control + streaming interfaces and the
//  frame buffers that are shared (zero copy) with the app and the GPU.
//

#ifndef U3VDriver_h
#define U3VDriver_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <USBDriverKit/IOUSBHostInterface.iig>
#include <USBDriverKit/IOUSBHostPipe.iig>
#include <DriverKit/IOMemoryDescriptor.iig>


class U3VDriver: public IOService
{
public:
    virtual bool init() override;
    virtual void free() override;

    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;
    virtual kern_return_t NewUserClient(uint32_t type, IOUserClient ** userClient) override;

    /* Called by U3VUserClient (same process, direct calls). */
    kern_return_t ReadMemory(uint64_t address, void * buffer, uint32_t length) LOCALONLY;
    kern_return_t WriteMemory(uint64_t address, const void * buffer, uint32_t length) LOCALONLY;
    kern_return_t StartStream(uint32_t requestedBuffers, uint64_t * bufferCount,
                              uint64_t * bufferSize, uint64_t * payloadSize) LOCALONLY;
    kern_return_t StopStream() LOCALONLY;
    kern_return_t CopyClientMemory(uint64_t type, IOMemoryDescriptor ** memory) LOCALONLY;
    void GetDeviceInfo(uint64_t * maxCmd, uint64_t * maxAck, uint64_t * sirm, uint64_t * responseMs) LOCALONLY;

protected:
    /* Bulk-in completion for the streaming endpoint (one action per transfer). */
    virtual void StreamComplete(OSAction * action,
                                IOReturn status,
                                uint32_t actualByteCount,
                                uint64_t completionTimestamp) TYPE(IOUSBHostPipe::CompleteAsyncIO);

private:
    kern_return_t Setup(IOService * provider) LOCALONLY;
    kern_return_t OpenInterfaces(IOService * provider) LOCALONLY;
    kern_return_t Transact(uint16_t command, uint64_t address, const void * writeData,
                           uint32_t writeLength, void * readData, uint32_t readLength) LOCALONLY;
    kern_return_t ConfigureBuffers(uint32_t count) LOCALONLY;
    void ReleaseBuffers() LOCALONLY;
    kern_return_t QueueSlot(uint32_t slot) LOCALONLY;
    void SegmentDone(uint32_t slot, uint32_t segment, IOReturn status, uint32_t bytes) LOCALONLY;
    void FinishFrame(uint32_t slot) LOCALONLY;
    void Replenish() LOCALONLY;
};

#endif /* U3VDriver_h */
